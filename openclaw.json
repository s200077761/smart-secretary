// openclaw.json — Smart Secretary gateway configuration
// Docs: https://openclaw.ai/gateway/configuration
//
// Sensitive values are read from environment variables.
// Copy .env.example to .env and fill in your tokens.
//
// Start the gateway:
//   pnpm openclaw:gateway
//
// Open the control dashboard:
//   pnpm openclaw:dashboard

{
  // ── Identity ────────────────────────────────────────────────────────────────
  identity: {
    name: "السكرتير الذكي",
    theme: "a bilingual (Arabic/English) personal AI secretary — professional, concise, and helpful",
    emoji: "🤖",
  },

  // ── AI Agent ────────────────────────────────────────────────────────────────
  agent: {
    // Workspace: where the agent stores session data and memory
    workspace: "./.openclaw/workspace",

    model: {
      // Primary model — falls back to the next available provider
      // Priority: Anthropic → OpenAI → Gemini
      primary: "anthropic/claude-haiku-4-5-20251001",
      fallbacks: [
        "openai/gpt-4o-mini",
        "gemini/gemini-2.0-flash",
      ],
    },
  },

  // ── Environment variables ────────────────────────────────────────────────────
  // Fallback values — real keys should come from the shell environment or .env
  env: {
    // AI Providers — set these in your .env
    // ANTHROPIC_API_KEY: "sk-ant-...",
    // OPENAI_API_KEY: "sk-...",
    // GEMINI_API_KEY: "...",
  },

  // ── Messaging Channels ───────────────────────────────────────────────────────
  channels: {
    // Telegram — set TELEGRAM_TOKEN in .env
    telegram: {
      enabled: true,
      botToken: { source: "env", key: "TELEGRAM_TOKEN" },
      // Allow all users (remove allowFrom to restrict access)
      groupPolicy: "open",
      groups: {
        "*": {
          requireMention: true,
        },
      },
    },

    // Discord — set DISCORD_BOT_TOKEN in .env
    discord: {
      enabled: true,
      token: { source: "env", key: "DISCORD_BOT_TOKEN" },
      dm: {
        enabled: true,
      },
      guilds: {
        // "*" means all servers the bot is in
        "*": {
          requireMention: false,
        },
      },
    },

    // WhatsApp — requires WhatsApp pairing (run: openclaw channels login)
    whatsapp: {
      enabled: false,
      // Once paired, set your number here to restrict who can message:
      // allowFrom: ["+966XXXXXXXXX"],
    },
  },

  // ── Routing ──────────────────────────────────────────────────────────────────
  routing: {
    queue: {
      mode: "collect",
      debounceMs: 500,
    },
  },

  // ── Logging ──────────────────────────────────────────────────────────────────
  logging: {
    level: "info",
    file: "./.openclaw/openclaw.log",
    consoleStyle: "pretty",
  },
}
