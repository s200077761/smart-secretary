# ── AI — Provider Selection ────────────────────────────────────────────────────
# Choose: huggingface | openai | anthropic | gemini
DEFAULT_AI_PROVIDER=huggingface

# ── AI — HuggingFace (default) ────────────────────────────────────────────────
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ── AI — OpenAI (optional) ────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── AI — Anthropic Claude (optional) ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── AI — Google Gemini (optional) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Firebase ──────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Full public URL (needed for Telegram/Discord webhook mode)
# SERVER_URL=https://your-app.onrender.com

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Optional: your Telegram chat ID to receive all user conversations
# ADMIN_CHAT_ID=123456789

# ── WhatsApp (Meta Business API) ──────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=smart_secretary_verify_2026

# ── Twilio (alternative WhatsApp sandbox + OTP Verify) ────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Discord (OpenClaw-style messaging integration) ────────────────────────────
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
# Ed25519 public key from Discord Developer Portal → General Information
DISCORD_PUBLIC_KEY=your_discord_public_key_here
